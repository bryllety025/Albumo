# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Obtained once by visiting /api/auth/google in a browser and following the
# consent flow — see the printed instructions on the callback page.
GOOGLE_REFRESH_TOKEN=

# No folder ID needed: the app auto-creates/reuses its own "Wedding Photos"
# folder in Drive on first upload (the drive.file scope can't see folders
# it didn't create itself, so a pasted-in folder ID wouldn't work anyway).

# Displayed as the page title, home-screen badge, PWA name, and notification
# title. Must keep the NEXT_PUBLIC_ prefix since it's also read client-side.
NEXT_PUBLIC_EVENT_NAME="Ellen and Brylle Wedding"
NEXT_PUBLIC_EVENT_SHORT_NAME="E&B Wedding"
