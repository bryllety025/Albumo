# A guest joins an event via a one-time entry link, /{slug}. proxy.ts
# verifies the slug against albumo-backend's public events endpoint and, if
# it's real, registers this device to that event via a cookie — every
# request afterwards (including this app's own API routes) reads the event
# from that cookie instead of a subdomain.
EVENTS_API_URL=http://localhost:3000
# Must match API_KEY in albumo-backend/.env.
EVENTS_API_KEY=

# Every event shares these AWS/S3 credentials — each event's photos just
# live under their own folder in the bucket, named after the event's slug.
# AWS IAM user needs s3:PutObject/GetObject/ListBucket on the bucket below.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
