# This app can serve multiple subdomains from a single deployment
# (e.g. app.albumo.net, demo.albumo.net). The subdomain is resolved per
# request (proxy.ts) to a tenant id, and each tenant's config lives behind
# its own prefixed env vars below. To add another subdomain, add its id to
# TENANT_IDS in lib/tenant.ts and copy a block below with the new prefix.

# --- app.albumo.net -----------------------------------------------------
# AWS IAM user with s3:PutObject/GetObject/ListBucket on the bucket below.
APP_AWS_REGION=
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=
APP_AWS_S3_BUCKET=

# Optional key prefix ("folder") inside the bucket. Leave blank to store
# photos at the bucket root. Change this any time to point at a different
# folder without touching code.
APP_AWS_S3_FOLDER=wedding-photos

# Displayed as the page title, home-screen badge, PWA name, and notification
# title for this tenant.
APP_EVENT_NAME="Ellen and Brylle Wedding"
APP_EVENT_SHORT_NAME="E&B Wedding"

# --- demo.albumo.net ------------------------------------------------------
DEMO_AWS_REGION=
DEMO_AWS_ACCESS_KEY_ID=
DEMO_AWS_SECRET_ACCESS_KEY=
DEMO_AWS_S3_BUCKET=
DEMO_AWS_S3_FOLDER=demo-photos

DEMO_EVENT_NAME="Albumo Demo"
DEMO_EVENT_SHORT_NAME="Demo"
