# This app can serve multiple subdomains from a single deployment
# (e.g. app.albumo.net, demo.albumo.net). The subdomain is resolved per
# request (proxy.ts) to a tenant id. All tenants share these AWS/S3
# credentials — each tenant's photos just live under their own folder in the
# bucket, named after the tenant_id. To add another subdomain, add its id to
# lib/tenants.config.ts (no env changes needed).

# AWS IAM user with s3:PutObject/GetObject/ListBucket on the bucket below.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
